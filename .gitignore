# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test binaries and coverage
*.test
*.out
coverage.txt
coverage.html

# Go workspace file
go.work
go.work.sum

# Dependency directory (pre-modules vendoring)
vendor/

# Build and tooling caches
.gocache/
.golangci-cache/

# Env and local config
.env
.env.local
*.local.yaml
*.local.yml

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# `sarnaut-pack build` writes a build report beside every manifest. It carries
# curation notes and reference counts, it is not an input to pack_id, and
# testdata/packs/README.md says it is deliberately not committed.
testdata/packs/*/build-report.json
